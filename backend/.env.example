# Backend Environment Configuration for Render / Production
DATABASE_URL="postgresql://username:password@host/database?sslmode=require"
JWT_ACCESS_SECRET="your-32-byte-random-jwt-access-secret"
JWT_REFRESH_SECRET="your-32-byte-random-jwt-refresh-secret"
GEMINI_API_KEY="your-google-gemini-api-key"
NODE_ENV="production"
PORT=3000

# Client frontend URL on Vercel (without trailing slash)
CLIENT_URL="https://your-frontend-project.vercel.app"
