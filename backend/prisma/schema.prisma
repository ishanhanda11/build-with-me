// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus{
  COMPLETED
  ABANDONED 
  ACTIVE
  PAUSED
}
enum Difficulty{
  EASY
  MEDIUM 
  HARD
  ADAPTIVE
}
enum ChallengeDifficulty{
  EASY
  MEDIUM 
  HARD
}

enum ExperienceLevel {
  BEGINNER        // Requires active mentorship/supervision (Freshers)
  INTERMEDIATE    // Operates independently on routine tasks
  ADVANCED        // Leads complex projects / mentors others
  EXPERT          // Defines architecture / sets technical vision
}

enum HelpPreference{
  HINT_FIRST
  PSEUDOCODE_FIRST
  SOLUTION_LAST
  ADAPTIVE
}

enum LearningStyle{
  VISUAL
  HANDS_ON
  THEORY
  MIXED 
}

enum ChallengeStatus {
  IN_PROGRESS
  COMPLETED
}

enum AttemptStatus{
  IN_PROGRESS
  COMPLETED
  FAILED
}
model User{
  id String @id @default(uuid())
  name String
  email String @unique
  passwordHash String
  profile LearnerProfile?
  projects Project[]
  refreshTokens RefreshToken[]
  challengeAttempts ChallengeAttempt[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}



model LearnerProfile{
  id String @id @default(uuid())
  goal String
  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetTimeFrame DateTime
  experienceLevel ExperienceLevel @default(BEGINNER)
  difficulty Difficulty @default(ADAPTIVE)
  helpPreference HelpPreference @default(ADAPTIVE)
  learningStyle LearningStyle @default(MIXED)
  availableHoursPerDay Int @default(2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project{
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenges Challenge[]
  title String
  description String?
  maxChallenges Int @default(8)
  status ProjectStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Challenge{
  id String @id @default(uuid())
  projectId String
  project Project @relation(fields: [projectId], references:[id], onDelete: Cascade)
  title String
  description String
  difficulty ChallengeDifficulty @default(MEDIUM)
  learningObjectives String[]
  challengeOrder Int
  status ChallengeStatus @default(IN_PROGRESS)
  challengeAttempts ChallengeAttempt[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([projectId, challengeOrder])
}

model RefreshToken{
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references:[id], onDelete: Cascade)
  tokenHash String
  revokedAt DateTime?
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChallengeAttempt{
  id String @id @default(uuid())
  challengeId String
  userId String
  challenge Challenge @relation(fields:[challengeId], references:[id], onDelete: Cascade)
  user User @relation(fields: [userId], references:[id], onDelete: Cascade)
  status AttemptStatus @default(IN_PROGRESS)
  hintsUsed       Int @default(0)
  pseudocodeUsed  Int @default(0)
  solutionUsed    Int @default(0)
  helpRequests ChallengeHelp[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  }


enum HelpType {
  HINT
  PSEUDOCODE
  SOLUTION
  USER_SOLUTION
  EVALUATION 
}

model ChallengeHelp{
  id String @id @default(uuid())
  attemptId String
  type HelpType
  content Json
  createdAt DateTime @default(now())
  attempt ChallengeAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
}

